  "cards": [
    {
      "dot": "cyan",
      "title": "双总线分工",
      "items": [
        "data_bus 承载高频传感器数据（零拷贝扇出）",
        "event_system 承载异常/网络/上云等低频事件",
        "两条总线在 cloud_upload 汇合"
      ]
    },
    {
      "dot": "rose",
      "title": "多云 Provider 抽象",
      "items": [
        "四个 Provider 实现同一 cloud_provider_t 接口",
        "publish_all 全部失败才触发离线缓存",
        "当前共享 protocol_mqtt 的单一 MQTT 连接"
      ]
    },
    {
      "dot": "amber",
      "title": "断网续传",
      "items": [
        "NVS 环形队列，写满覆盖最旧条目",
        "protocol_mqtt 以 CLOUD_CONNECTED/DISCONNECTED 触发批量重播",
        "CLOUD_UPLOAD（缓存）与 CLOUD_REPLAY（回放）语义分流"
      ]
    }
  ]
