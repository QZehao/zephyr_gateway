  "cards": [
    {
      "dot": "emerald",
      "title": "事件语义分流",
      "items": [
        "CLOUD_UPLOAD 为缓存语义，仅 offline_cache 订阅",
        "CLOUD_REPLAY 为回放语义，仅 cloud_upload 订阅直发",
        "独立类型杜绝缓存回环与断网期无效重试"
      ]
    },
    {
      "dot": "orange",
      "title": "可靠性设计",
      "items": [
        "peek/commit 两段式：REPLAY 发布失败时下轮重试同一条目",
        "环形队列写满覆盖最旧，条数上限由 Kconfig 约束",
        "head/tail/count/CRC 持久化，缓存可跨重启存活"
      ]
    },
    {
      "dot": "rose",
      "title": "丢弃边界",
      "items": [
        "REPLAY 事件发布成功即 commit 出缓存",
        "直发失败或无 Provider 时本条丢弃并记录告警",
        "cached_count 为 RAM 估计值，重启归零并带下溢保护"
      ]
    }
  ]
